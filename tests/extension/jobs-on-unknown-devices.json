{
  "format": "gamescrcpy.ext-test",
  "version": 1,
  "name": "Jobs on a device that is neither a board nor a serial port fail with a reason, and the panels hear about it",
  "settings": { "port": "COM250", "link": "serial", "address": "" },
  "timeout": 5000,
  "steps": [
    {
      "do": "job",
      "job": "diagnose",
      "args": { "device": "nonsense" },
      "expect": {
        "error": "GS-API-065",
        "events": [{ "topic": "board.diagnosed", "value": { "device": "nonsense", "ok": false } }]
      }
    },
    {
      "do": "job",
      "job": "flash",
      "args": { "device": "nonsense" },
      "expect": {
        "error": "GS-API-065",
        "events": [{ "topic": "flash.done", "value": { "device": "nonsense", "ok": false } }]
      }
    },
    {
      "do": "job",
      "job": "wifi",
      "args": { "device": "serial-com7", "ssid": "Home", "password": "secret" },
      "expect": { "error": "GS-API-065" }
    },
    {
      "do": "job",
      "job": "rename",
      "args": { "device": "serial-com7", "name": "Desk box" },
      "expect": { "error": "GS-API-065" }
    }
  ]
}
