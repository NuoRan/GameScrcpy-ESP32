{
  "format": "gamescrcpy.ext-test",
  "version": 1,
  "name": "With the serial port set to one that is not there, the nodes answer, the provider lists nothing and actions on unknown boards are refused",
  "settings": { "port": "COM250", "link": "serial", "address": "" },
  "steps": [
    { "do": "call", "node": "boards", "expect": { "value": [] } },
    { "do": "call", "node": "ports" },
    { "do": "call", "node": "firmware" },
    { "do": "call", "node": "language" },
    { "do": "call", "node": "problem" },
    { "do": "call", "node": "tap", "args": ["serial-com7"], "expect": { "value": false } },
    { "do": "call", "node": "disconnect", "args": ["serial-com7"], "expect": { "value": false } },
    { "do": "call", "node": "rescan", "expect": { "value": true } },
    { "do": "devices", "provider": "boards", "expect": { "devices": [], "count": 0 } },
    {
      "do": "device.act",
      "provider": "boards",
      "device": "serial-com7",
      "action": "tap",
      "expect": { "error": true }
    },
    {
      "do": "claim.want",
      "resource": "serial:COM9",
      "by": "Your logic",
      "expect": { "held": false, "yielded": true, "released": false }
    }
  ]
}
